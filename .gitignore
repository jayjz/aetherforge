# ==============================================================================
# AETHERFORGE SECURE .GITIGNORE
# ==============================================================================

# 1. SENSITIVE DATA & SECRETS (NEVER COMMIT)
.env
.env.*
*.env
secrets.json
config.json
credentials.json
*.pem
*.key
*.cert
id_rsa
id_rsa.pub

# 2. PYTHON ENVIRONMENTS & CACHES
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# 3. ML MODELS & LARGE BINARIES (VRAM/STORAGE PROTECTION)
*.gguf
*.bin
*.pt
*.safetensors
models/
checkpoints/
*.sqlite3
*.db

# 4. LOGS & TELEMETRY (DATA PRIVACY)
